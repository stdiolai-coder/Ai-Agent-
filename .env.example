# Diese Datei zu ".env" umbenennen und mit echten Werten füllen.
# NIEMALS diese Datei mit echten Zugangsdaten öffentlich teilen oder in Git einchecken!

# --- Google Gemini / KI (kostenlose Stufe) ---
GOOGLE_API_KEY=dein-google-api-key
AI_MODEL=gemini-2.0-flash

# --- Unternehmens-Kontext ---
COMPANY_NAME=Mein Unternehmen
COMPANY_DESCRIPTION=Beschreibe hier kurz, was dein Unternehmen macht, damit die KI passend antwortet.

# --- E-Mail ---
EMAIL_ADDRESS=info@deinefirma.de
EMAIL_PASSWORD=dein-email-passwort-oder-app-passwort
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_POLL_INTERVAL_SECONDS=30

# --- Twilio (Anrufe & WhatsApp) ---
TWILIO_ACCOUNT_SID=dein-twilio-account-sid
TWILIO_AUTH_TOKEN=dein-twilio-auth-token
TWILIO_PHONE_NUMBER=+49xxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+49xxxxxxxxx

# --- Datenbank ---
DATABASE_URL=sqlite:///./agent.db
